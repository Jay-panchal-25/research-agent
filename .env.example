# ---------- Meta WhatsApp Cloud API ----------
META_APP_SECRET=
WA_VERIFY_TOKEN=choose-any-random-string
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
# digits only, with country code, no "+", comma separated. Empty = nobody allowed.
ALLOWED_NUMBERS=

# ---------- Infra ----------
REDIS_URL=redis://127.0.0.1:6379
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=research_agent
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ---------- LLM (Groq via LiteLLM) ----------
GROQ_API_KEY=
# check console.groq.com/docs/models for current model ids
MODEL_FAST=groq/openai/gpt-oss-20b
MODEL_MAIN=groq/llama-3.3-70b-versatile
MODEL_STRONG=groq/llama-3.3-70b-versatile
MODEL_FALLBACK=groq/openai/gpt-oss-20b

# ---------- Embeddings (API only) ----------
# Any LiteLLM embedding model + its key. Pick ONE and never change it later
# (changing it means deleting the Qdrant collection and re-embedding).
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_API_KEY=

# ---------- Optional tuning ----------
# OPENALEX_EMAIL=you@example.com
# MAX_SUB_QUESTIONS=5
# MAX_CRITIC_LOOPS=1
# BUDGET_MAX_SECONDS=900
# MAX_MESSAGES_PER_DAY=30
# LOG_LEVEL=INFO
